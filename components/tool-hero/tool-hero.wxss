.tool-hero {
  margin: 24rpx 24rpx 0;
  padding: 26rpx 24rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background:
    radial-gradient(circle at top right, rgba(45, 99, 133, 0.14), transparent 36%),
    radial-gradient(circle at bottom left, rgba(194, 122, 74, 0.14), transparent 32%),
    linear-gradient(160deg, rgba(255, 252, 248, 0.98) 0%, rgba(247, 240, 230, 0.94) 100%);
  border: 2rpx solid rgba(93, 66, 50, 0.06);
  box-shadow: 0 16rpx 34rpx rgba(47, 33, 24, 0.08);
}

.tool-hero__icon-shell {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.42);
}

.tool-hero__body {
  min-width: 0;
  flex: 1;
}

.tool-hero__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tool-hero__chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(54, 43, 38, 0.06);
  color: #5f564d;
  font-size: 20rpx;
  line-height: 1;
}

.tool-hero__chip--accent {
  background: linear-gradient(135deg, rgba(143, 61, 46, 0.14), rgba(194, 122, 74, 0.16));
  color: #8f3d2e;
}

.tool-hero__title {
  display: block;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #241b16;
}

.tool-hero__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #74675f;
}
