/* pages/radix/radix.wxss */
.section {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  display: block;
}

.base-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.base-tab {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
}

.base-tab--active {
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  color: #fff;
}

.input-row {
  margin-bottom: 20rpx;
}

.text-input {
  width: 100%;
  height: 88rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-family: monospace;
  box-sizing: border-box;
}

.result-section {
  margin-top: 24rpx;
}

.result-item {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.result-item:last-child {
  margin-bottom: 0;
}

.result-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #8e8e93;
  flex-shrink: 0;
}

.result-value {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a2e;
  font-family: monospace;
  word-break: break-all;
}

.result-copy {
  font-size: 24rpx;
  color: #4a90d9;
  margin-left: 16rpx;
  flex-shrink: 0;
}
