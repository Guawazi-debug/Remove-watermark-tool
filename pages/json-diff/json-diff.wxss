.input-section { margin: 24rpx 32rpx 0; display: flex; gap: 16rpx; }
.input-col { flex: 1; }
.input-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.label { font-size: 26rpx; font-weight: 600; color: #1a1a2e; }
.paste-btn { font-size: 22rpx; color: #4a90d9; }
.textarea-wrapper { background: #fff; border-radius: 12rpx; padding: 16rpx; border: 2rpx solid #e8f0fe; }
.textarea { width: 100%; height: 200rpx; font-size: 24rpx; color: #333; line-height: 1.5; font-family: monospace; }
.action-row { margin: 24rpx 32rpx 0; display: flex; gap: 16rpx; }
.action-row .btn { flex: 1; height: 80rpx; }
.section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.diff-list { margin-top: 12rpx; }
.diff-item { padding: 12rpx; border-radius: 8rpx; margin-bottom: 8rpx; font-size: 24rpx; }
.diff-item.added { background: #f0fff4; }
.diff-item.removed { background: #fff5f5; }
.diff-item.changed { background: #fffbe6; }
.diff-path { font-weight: 600; color: #1a1a2e; margin-right: 12rpx; font-family: monospace; }
.diff-type { font-size: 22rpx; }
.diff-item.added .diff-type { color: #00b894; }
.diff-item.removed .diff-type { color: #e74c3c; }
.diff-item.changed .diff-type { color: #fdcb6e; }
.diff-value { display: block; font-family: monospace; color: #666; margin-top: 4rpx; }
.diff-old { color: #e74c3c; text-decoration: line-through; }
.diff-arrow { margin: 0 8rpx; color: #999; }
.diff-new { color: #00b894; }
