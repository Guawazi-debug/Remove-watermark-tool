/* pages/password-gen/password-gen.wxss */
.config-section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.section-title { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 20rpx; display: block; }
.config-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.config-item:last-of-type { border-bottom: none; margin-bottom: 20rpx; }
.config-label { font-size: 28rpx; color: #333; }
.length-input { width: 120rpx; height: 64rpx; background: #f5f6fa; border-radius: 8rpx; text-align: center; font-size: 28rpx; font-family: monospace; }
.checkbox { width: 48rpx; height: 48rpx; border-radius: 8rpx; border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; }
.checkbox.checked { background: #4a90d9; border-color: #4a90d9; }
.result-section { margin: 32rpx 32rpx 0; }
.result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.result-title { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.action-btn { padding: 8rpx 24rpx; border-radius: 8rpx; background: #f0f0f0; font-size: 24rpx; color: #4a90d9; }
.pwd-list { display: flex; flex-direction: column; gap: 12rpx; }
.pwd-item { background: #fff; border-radius: 12rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.pwd-text { flex: 1; font-size: 26rpx; color: #333; font-family: monospace; }
.pwd-copy { font-size: 24rpx; color: #4a90d9; margin-left: 16rpx; }
