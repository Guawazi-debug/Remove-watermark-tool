<!--pages/password-gen/password-gen.wxml-->
<navigation-bar title="密码生成" back="{{true}}" homeButton="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-root" scroll-y enable-flex>

  <tool-hero></tool-hero>

  <view class="config-section">
    <text class="section-title">密码配置</text>

    <view class="config-item">
      <text class="config-label">密码长度</text>
      <input class="length-input" type="number" value="{{length}}" bindinput="onLengthChange" />
    </view>

    <view class="config-item" data-key="includeUpper" bindtap="onToggleOption">
      <text class="config-label">大写字母 (A-Z)</text>
      <view class="checkbox {{includeUpper ? 'checked' : ''}}">{{includeUpper ? '✓' : ''}}</view>
    </view>

    <view class="config-item" data-key="includeLower" bindtap="onToggleOption">
      <text class="config-label">小写字母 (a-z)</text>
      <view class="checkbox {{includeLower ? 'checked' : ''}}">{{includeLower ? '✓' : ''}}</view>
    </view>

    <view class="config-item" data-key="includeNumbers" bindtap="onToggleOption">
      <text class="config-label">数字 (0-9)</text>
      <view class="checkbox {{includeNumbers ? 'checked' : ''}}">{{includeNumbers ? '✓' : ''}}</view>
    </view>

    <view class="config-item" data-key="includeSymbols" bindtap="onToggleOption">
      <text class="config-label">特殊符号 (!@#$...)</text>
      <view class="checkbox {{includeSymbols ? 'checked' : ''}}">{{includeSymbols ? '✓' : ''}}</view>
    </view>

    <view class="btn btn--primary" bindtap="onGenerate"><text>生成密码</text></view>
  </view>

  <view class="result-section" wx:if="{{passwords.length > 0}}">
    <view class="result-header">
      <text class="result-title">生成结果</text>
      <view class="action-btn" bindtap="onCopyAll"><text>全部复制</text></view>
    </view>
    <view class="pwd-list">
      <view class="pwd-item" wx:for="{{passwords}}" wx:key="index" data-pwd="{{item}}" bindtap="onCopy">
        <text class="pwd-text" selectable>{{item}}</text>
        <text class="pwd-copy">复制</text>
      </view>
    </view>
  </view>

</scroll-view>
