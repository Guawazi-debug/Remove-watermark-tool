/* pages/text-replace/text-replace.wxss */
.section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.label { font-size: 26rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.textarea-wrapper { background: #f5f6fa; border-radius: 12rpx; padding: 16rpx; }
.textarea { width: 100%; height: 200rpx; font-size: 26rpx; color: #333; line-height: 1.5; }
.input-group { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.input-item { flex: 1; }
.input { height: 72rpx; background: #f5f6fa; border-radius: 10rpx; padding: 0 16rpx; font-size: 26rpx; }
.result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.result-title { font-size: 26rpx; font-weight: 600; color: #1a1a2e; }
.result-info { font-size: 22rpx; color: #00b894; }
.result-content { background: #f5f6fa; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; color: #333; word-break: break-all; line-height: 1.6; margin-bottom: 16rpx; }
