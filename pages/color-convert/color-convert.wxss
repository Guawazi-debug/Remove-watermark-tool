/* pages/color-convert/color-convert.wxss */
.preview-section { margin: 24rpx 32rpx 0; display: flex; align-items: center; gap: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.preview-box { width: 120rpx; height: 120rpx; border-radius: 16rpx; border: 2rpx solid #e8f0fe; }
.preview-text { font-size: 32rpx; font-family: monospace; color: #1a1a2e; font-weight: 600; }
.format-section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.section-title { font-size: 26rpx; font-weight: 600; color: #4a90d9; margin-bottom: 12rpx; display: block; }
.input-row { display: flex; gap: 12rpx; align-items: center; }
.text-input { flex: 1; height: 72rpx; background: #f5f6fa; border-radius: 8rpx; padding: 0 16rpx; font-size: 28rpx; font-family: monospace; }
.copy-btn { height: 56rpx; padding: 0 24rpx; background: #f0f0f0; border-radius: 8rpx; display: flex; align-items: center; font-size: 24rpx; color: #4a90d9; margin-top: 12rpx; }
.rgb-row { display: flex; gap: 16rpx; }
.rgb-item { flex: 1; }
.rgb-label { font-size: 24rpx; color: #666; margin-bottom: 8rpx; display: block; }
.rgb-input { width: 100%; height: 72rpx; background: #f5f6fa; border-radius: 8rpx; padding: 0 16rpx; font-size: 28rpx; font-family: monospace; text-align: center; }
