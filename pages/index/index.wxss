/* pages/index/index.wxss */

.page-root {
  height: 100vh;
  background: linear-gradient(180deg, #e8f0fe 0%, #f5f6fa 40%);
  display: flex;
  flex-direction: column;
}

/* ===== 头部区域 ===== */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
}

.hero-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.hero-icon__text {
  font-size: 40rpx;
  color: #fff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: #8e8e93;
}

/* ===== 输入区域 ===== */
.input-section {
  margin: 16rpx 32rpx 0;
  flex-shrink: 0;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.1);
  padding: 0 24rpx;
  border: 2rpx solid #e8f0fe;
}

.url-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: #333;
}

.placeholder-style {
  color: #c0c0c0;
}

.clear-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 28rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn--primary {
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.btn--primary.btn--disabled {
  opacity: 0.6;
}

.btn--secondary {
  background: #fff;
  color: #4a90d9;
  border: 2rpx solid #4a90d9;
}

.btn--download {
  margin: 24rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #34c759, #30d158);
  color: #fff;
  border-radius: 14rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(52, 199, 89, 0.3);
}

/* ===== 错误提示 ===== */
.error-msg {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #e74c3c;
}

/* ===== 使用说明 ===== */
.guide-section {
  margin: 40rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guide-step {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guide-text {
  font-size: 26rpx;
  color: #666;
}

/* ===== 加载状态 ===== */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e8f0fe;
  border-top-color: #4a90d9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

/* ===== 解析结果 ===== */
.result-section {
  margin: 24rpx 32rpx 0;
}

.result-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.result-video {
  width: 100%;
  height: 400rpx;
  display: block;
}

.result-btns {
  padding: 0 24rpx 24rpx;
  margin: 0;
}

.result-info {
  padding: 24rpx;
}

.result-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.result-meta {
  margin-top: 12rpx;
  display: flex;
  gap: 24rpx;
}
