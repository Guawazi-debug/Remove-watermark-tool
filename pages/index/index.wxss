.index-page {
  background: #F8F3EC;
  padding-bottom: 120rpx;
}

.hero-panel {
  margin: 28rpx 24rpx 22rpx;
  padding: 36rpx 28rpx 30rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at top right, rgba(198, 137, 112, 0.24), transparent 36%),
    radial-gradient(circle at bottom left, rgba(66, 116, 154, 0.18), transparent 32%),
    linear-gradient(160deg, #fbf6ef 0%, #f3ebdf 100%);
  box-shadow: 0 20rpx 40rpx rgba(47, 33, 24, 0.08);
}

.hero-kicker {
  display: inline-flex;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(36, 27, 22, 0.06);
  color: #6a594f;
  font-size: 20rpx;
  letter-spacing: 1.2rpx;
  margin-bottom: 18rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #201914;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6a594f;
}

.hero-search {
  margin-top: 28rpx;
}

.hero-search__label {
  display: block;
  font-size: 22rpx;
  color: #7c6c62;
  margin-bottom: 12rpx;
}

.hero-search__box {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(54, 43, 38, 0.08);
  border-radius: 24rpx;
  padding: 0 18rpx;
}

.hero-search__icon {
  font-size: 20rpx;
  color: #8d5b47;
  letter-spacing: 1rpx;
  margin-right: 14rpx;
}

.hero-search__input {
  flex: 1;
  height: 94rpx;
  font-size: 28rpx;
  color: #241b16;
}

.hero-search__placeholder {
  color: #a6978d;
}

.hero-search__clear {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(54, 43, 38, 0.06);
  color: #6d5b50;
  font-size: 22rpx;
}

.hero-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 26rpx;
}

.hero-summary__item {
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.7);
}

.hero-summary__name {
  display: block;
  font-size: 22rpx;
  color: #7a6c63;
  margin-bottom: 8rpx;
}

.hero-summary__count {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.section-block {
  margin: 0 24rpx 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #211a15;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a6c63;
}

.recent-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.recent-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  border: 2rpx solid rgba(54, 43, 38, 0.06);
}

.recent-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.recent-card__info {
  flex: 1;
  min-width: 0;
}

.recent-card__name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #241b16;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recent-card__category {
  display: block;
  font-size: 20rpx;
  color: #8c7e72;
  margin-top: 4rpx;
}

.featured-grid,
.category-card__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.category-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-card {
  padding: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(54, 43, 38, 0.06);
}

.category-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.category-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #241b16;
}

.category-card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a6c63;
}

.category-card__count {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(54, 43, 38, 0.06);
  color: #66574d;
  font-size: 22rpx;
}

.empty-state {
  padding: 56rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  text-align: center;
}

.empty-state__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #241b16;
}

.empty-state__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7a6c63;
}

/* 公告弹窗 */
.announcement-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.announcement-modal {
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.announcement-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(93, 66, 50, 0.08);
}

.announcement-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #241b16;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announcement-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
  cursor: pointer;
}

.announcement-body {
  padding: 32rpx;
  max-height: 400rpx;
}

.announcement-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
}

.announcement-footer {
  display: flex;
  border-top: 1rpx solid rgba(93, 66, 50, 0.08);
}

.announcement-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  font-size: 28rpx;
  cursor: pointer;
}

.announcement-btn--close {
  color: #666;
  border-right: 1rpx solid rgba(93, 66, 50, 0.08);
}

.announcement-btn--view {
  color: #8f3d2e;
  font-weight: 500;
}
