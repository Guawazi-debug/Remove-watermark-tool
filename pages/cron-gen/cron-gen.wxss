.section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.label { font-size: 26rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.preset-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.preset-item { padding: 12rpx 24rpx; background: #f5f6fa; border-radius: 8rpx; font-size: 24rpx; color: #4a90d9; }
.cron-inputs { display: flex; gap: 12rpx; }
.cron-item { flex: 1; text-align: center; }
.cron-label { font-size: 22rpx; color: #999; margin-bottom: 8rpx; display: block; }
.cron-input { height: 64rpx; background: #f5f6fa; border-radius: 8rpx; text-align: center; font-size: 28rpx; font-family: monospace; }
.result-section { background: linear-gradient(135deg, #f8f9fa, #e9ecef); }
.result-box { background: #1a1a2e; border-radius: 12rpx; padding: 24rpx; text-align: center; margin-bottom: 16rpx; }
.result-cron { font-size: 40rpx; color: #00b894; font-family: monospace; font-weight: 600; }
