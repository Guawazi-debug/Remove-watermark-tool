<navigation-bar title="AI 生图" back="{{true}}" homeButton="{{true}}" color="#241b16" background="#F8F3EC"></navigation-bar>

<scroll-view class="page-root ai-image-page" scroll-y enable-flex show-scrollbar="{{false}}">
  <tool-hero></tool-hero>

  <!-- 使用须知 -->
  <view class="notice-banner">
    <text class="notice-banner__text">使用须知：请勿生成违规、侵权、色情、暴力等违法内容。生成的图片会在24小时后失效，请及时保存。图片可在此页面和生图历史中查看。</text>
  </view>

  <!-- 输入区域 -->
  <view class="section">
    <view class="section-title">图片描述</view>
    <view class="textarea-wrapper">
      <textarea
        class="input-textarea"
        placeholder="描述你想要生成的图片，例如：一只可爱的橘猫在阳光下打盹"
        value="{{prompt}}"
        bindinput="onPromptInput"
        maxlength="1000"
        auto-height
      ></textarea>
      <view class="char-count">{{prompt.length}}/1000</view>
    </view>
  </view>

  <!-- 模型选择 -->
  <view class="section">
    <view class="section-title">选择模型</view>
    <view class="model-options">
      <view
        class="model-option {{selectedModel === 'hunyuan' ? 'model-option--active' : ''}}"
        bindtap="onModelTap"
        data-model="hunyuan"
      >
        <text class="model-name">混元生图</text>
        <text class="model-desc">腾讯云开发，免费</text>
      </view>
      <view
        class="model-option {{selectedModel === 'gpt' ? 'model-option--active' : ''}}"
        bindtap="onModelTap"
        data-model="gpt"
      >
        <text class="model-name">GPT 生图</text>
        <text class="model-desc">GPT-Image-2，高清</text>
      </view>
    </view>
  </view>

  <!-- 参数设置 -->
  <view class="section">
    <view class="settings-header" bindtap="onToggleSettings">
      <text class="section-title">参数设置</text>
      <text class="settings-arrow {{showSettings ? 'settings-arrow--open' : ''}}">›</text>
    </view>

    <view class="settings-body" wx:if="{{showSettings}}">
      <!-- 图片尺寸 -->
      <view class="setting-item">
        <text class="setting-label">图片尺寸</text>
        <view class="size-options">
          <view
            class="size-option {{selectedSize === item.value ? 'size-option--active' : ''}}"
            wx:for="{{selectedModel === 'gpt' ? gptSizeOptions : sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onSizeTap"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 提示词改写 -->
      <view class="setting-item">
        <text class="setting-label">提示词改写</text>
        <text class="setting-desc">开启后模型会自动优化你的描述</text>
        <switch checked="{{revise}}" bindchange="onReviseChange" color="#8f3d2e" />
      </view>

      <!-- 水印 -->
      <view class="setting-item">
        <text class="setting-label">水印文字</text>
        <input
          class="setting-input"
          placeholder="可选，最多16字"
          value="{{footnote}}"
          bindinput="onFootnoteInput"
          maxlength="16"
        />
      </view>

      <!-- 种子 -->
      <view class="setting-item">
        <text class="setting-label">随机种子</text>
        <input
          class="setting-input"
          type="number"
          placeholder="可选，1-4294967295"
          value="{{seed}}"
          bindinput="onSeedInput"
        />
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="section">
    <button
      class="btn btn--primary generate-btn"
      disabled="{{loading || !prompt}}"
      bindtap="onGenerate"
    >
      <text wx:if="{{loading}}">生成中...</text>
      <text wx:else>开始生成</text>
    </button>
  </view>

  <!-- 生成结果 -->
  <view class="section result-section" wx:if="{{imageUrl}}">
    <view class="section-title">生成结果</view>
    <view class="result-image-wrapper">
      <image
        class="result-image"
        src="{{imageUrl}}"
        mode="widthFix"
        bindtap="onPreviewImage"
        show-menu-by-longpress
      ></image>
    </view>
    <!-- 图片链接 -->
    <view class="url-box">
      <text class="url-label">图片链接（24小时内有效）</text>
      <view class="url-content">
        <text class="url-text" selectable>{{imageUrl}}</text>
        <view class="url-copy-btn" bindtap="onCopyUrl">复制</view>
      </view>
    </view>
    <view class="result-actions">
      <button class="btn btn--secondary result-btn" bindtap="onSaveImage">保存图片</button>
      <button class="btn btn--secondary result-btn" open-type="share">分享图片</button>
    </view>
  </view>

  <!-- 错误提示 -->
  <view class="error-msg" wx:if="{{errorMsg}}">
    <text>{{errorMsg}}</text>
  </view>
</scroll-view>
