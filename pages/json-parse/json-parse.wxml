<!--pages/json-parse/json-parse.wxml-->
<navigation-bar title="JSON 解析" back="{{true}}" homeButton="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-root" scroll-y enable-flex>

  <tool-hero></tool-hero>

  <!-- 输入区域 -->
  <view class="input-section">
    <view class="input-header">
      <text class="input-label">输入 JSON 字符串</text>
    </view>
    <view class="textarea-wrapper">
      <textarea
        class="json-textarea"
        placeholder="粘贴 JSON 字符串..."
        placeholder-class="placeholder-style"
        value="{{inputText}}"
        bindinput="onInputChange"
        maxlength="-1"
      />
    </view>

    <view class="btn-row">
      <view class="btn btn--secondary" bindtap="onPaste">
        <text>粘贴</text>
      </view>
      <view class="btn btn--secondary" bindtap="onClear">
        <text>清空</text>
      </view>
    </view>

    <view class="btn-row" style="margin-top: 16rpx;">
      <view class="btn btn--primary" bindtap="onParse">
        <text>开始解析</text>
      </view>
    </view>

    <!-- 错误提示 -->
    <view class="error-msg" wx:if="{{errorMsg}}">
      <text>{{errorMsg}}</text>
    </view>
  </view>

  <!-- 解析结果 -->
  <view class="result-section" wx:if="{{showResult}}">
    <view class="result-header">
      <view class="result-info">
        <text class="result-title">解析结果</text>
        <text class="result-time" wx:if="{{parseTime}}">耗时 {{parseTime}}</text>
      </view>
      <view class="result-actions">
        <view class="action-btn" bindtap="onToggleFormat">
          <text>{{isMinified ? '格式化' : '压缩'}}</text>
        </view>
        <view class="action-btn action-btn--primary" bindtap="onCopyResult">
          <text>复制</text>
        </view>
      </view>
    </view>
    <json-viewer json="{{formattedText}}" />
  </view>

</scroll-view>
