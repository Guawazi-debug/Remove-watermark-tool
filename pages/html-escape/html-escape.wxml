<!--pages/html-escape/html-escape.wxml-->
<navigation-bar title="HTML 转义" back="{{true}}" homeButton="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="page-root" scroll-y enable-flex show-scrollbar="{{false}}">

  <tool-hero></tool-hero>
  <view class="section">
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'encode' ? 'active' : ''}}" data-mode="encode" bindtap="onModeChange"><text>编码</text></view>
      <view class="mode-tab {{mode === 'decode' ? 'active' : ''}}" data-mode="decode" bindtap="onModeChange"><text>解码</text></view>
    </view>
    <text class="label">{{mode === 'encode' ? '输入 HTML' : '输入实体编码'}}</text>
    <view class="textarea-wrapper"><textarea class="textarea" placeholder="输入内容..." value="{{inputText}}" bindinput="onInputChange" maxlength="-1" /></view>
    <view class="btn-row">
      <view class="btn btn--secondary" bindtap="onPaste"><text>粘贴</text></view>
      <view class="btn btn--secondary" bindtap="onClear"><text>清空</text></view>
      <view class="btn btn--primary" bindtap="onConvert"><text>转换</text></view>
    </view>
  </view>
  <view class="section" wx:if="{{outputText}}">
    <view class="result-header">
      <text class="label">转换结果</text>
      <view class="btn-group">
        <view class="action-btn" bindtap="onSwap"><text>互换</text></view>
        <view class="action-btn primary" bindtap="onCopy"><text>复制</text></view>
      </view>
    </view>
    <view class="result-content"><text selectable>{{outputText}}</text></view>
  </view>
</scroll-view>
