<!--pages/word-count/word-count.wxml-->
<navigation-bar title="字数统计" back="{{true}}" homeButton="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-root" scroll-y enable-flex show-scrollbar="{{false}}">

  <tool-hero></tool-hero>

  <view class="input-section">
    <view class="textarea-wrapper">
      <textarea class="input-textarea" placeholder="输入或粘贴文本..." value="{{inputText}}" bindinput="onInputChange" maxlength="-1" />
    </view>
    <view class="btn-row">
      <view class="btn btn--secondary" bindtap="onPaste"><text>粘贴</text></view>
      <view class="btn btn--secondary" bindtap="onClear"><text>清空</text></view>
    </view>
  </view>

  <view class="stats-section" wx:if="{{stats}}">
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">{{stats.chars}}</text>
        <text class="stat-label">总字符</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.charsNoSpace}}</text>
        <text class="stat-label">不含空格</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.words}}</text>
        <text class="stat-label">单词数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.lines}}</text>
        <text class="stat-label">行数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.chinese}}</text>
        <text class="stat-label">中文</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.english}}</text>
        <text class="stat-label">英文字母</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.numbers}}</text>
        <text class="stat-label">数字</text>
      </view>
    </view>
  </view>

</scroll-view>
