/* pages/hash/hash.wxss */
.input-section { margin: 24rpx 32rpx 0; }
.input-label { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.textarea-wrapper { background: #fff; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #e8f0fe; }
.input-textarea { width: 100%; height: 200rpx; font-size: 26rpx; color: #333; line-height: 1.5; overflow-y: auto; }
.result-section { margin: 32rpx 32rpx 0; display: flex; flex-direction: column; gap: 16rpx; }
.hash-item { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.hash-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.hash-label { font-size: 26rpx; font-weight: 600; color: #4a90d9; }
.hash-copy { font-size: 24rpx; color: #4a90d9; }
.hash-value { font-size: 24rpx; color: #333; font-family: monospace; word-break: break-all; line-height: 1.6; }
