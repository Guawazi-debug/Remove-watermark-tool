.mode-tabs { display: flex; gap: 14rpx; margin-bottom: 18rpx; }
.mode-tab { flex: 1; min-height: 72rpx; border-radius: 18rpx; background: rgba(255, 255, 255, 0.8); border: 2rpx solid rgba(93, 66, 50, 0.08); display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #74675f; }
.mode-tab.active { background: linear-gradient(135deg, #8f3d2e, #b45f3d); color: #fff7f0; box-shadow: 0 10rpx 22rpx rgba(143, 61, 46, 0.18); border-color: transparent; }
.textarea-wrapper { margin-bottom: 16rpx; }
.textarea { height: 280rpx; font-family: monospace; }
.result-content { background: linear-gradient(180deg, #221c19 0%, #1a1513 100%); color: #f4d8c0; white-space: pre-wrap; word-break: break-all; border-color: rgba(255, 255, 255, 0.06); }
