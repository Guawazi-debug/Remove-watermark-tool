.category-page {
  background: #F8F3EC;
  padding-bottom: 120rpx;
}

.category-header {
  padding: 32rpx 32rpx 24rpx;
}

.category-header__title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #241b16;
  margin-bottom: 8rpx;
}

.category-header__desc {
  display: block;
  font-size: 26rpx;
  color: #8c7e72;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 20rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border-left: 6rpx solid;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.category-item__info {
  flex: 1;
}

.category-item__name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #241b16;
  margin-bottom: 6rpx;
}

.category-item__desc {
  display: block;
  font-size: 24rpx;
  color: #8c7e72;
}

.category-item__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.category-item__count {
  font-size: 24rpx;
  color: #8c7e72;
}

.category-item__arrow {
  font-size: 36rpx;
  color: #c4b5a8;
}

.tool-list__header {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f0eb;
  border-radius: 12rpx;
}

.back-btn__icon {
  font-size: 36rpx;
  color: #d36b4c;
  font-weight: 600;
  line-height: 1;
}

.tool-list__title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tool-list__desc {
  display: block;
  font-size: 26rpx;
  color: #8c7e72;
}

.tool-search {
  padding: 0 32rpx 24rpx;
}

.tool-search__box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.tool-search__icon {
  font-size: 24rpx;
  color: #c4b5a8;
  margin-right: 12rpx;
}

.tool-search__input {
  flex: 1;
  font-size: 28rpx;
  color: #241b16;
}

.tool-search__placeholder {
  color: #c4b5a8;
}

.tool-search__clear {
  padding: 8rpx 12rpx;
}

.tool-search__clear text {
  font-size: 24rpx;
  color: #d36b4c;
}

.tool-grid {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tool-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.tool-card__info {
  flex: 1;
}

.tool-card__name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #241b16;
  margin-bottom: 6rpx;
}

.tool-card__desc {
  display: block;
  font-size: 24rpx;
  color: #8c7e72;
}

.empty-state {
  padding: 100rpx 32rpx;
  text-align: center;
}

.empty-state__title {
  display: block;
  font-size: 32rpx;
  color: #8c7e72;
  margin-bottom: 12rpx;
}

.empty-state__desc {
  display: block;
  font-size: 26rpx;
  color: #c4b5a8;
}
