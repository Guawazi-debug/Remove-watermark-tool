.section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.label { font-size: 26rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.date-row { margin-bottom: 16rpx; }
.date-picker { height: 80rpx; background: #f5f6fa; border-radius: 10rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; }
.date-text { font-size: 28rpx; color: #333; }
.date-icon { font-size: 32rpx; }
.result-section { background: linear-gradient(135deg, #f8f9fa, #e9ecef); }
.age-main { display: flex; align-items: baseline; justify-content: center; padding: 24rpx 0; }
.age-number { font-size: 56rpx; font-weight: 700; color: #4a90d9; }
.age-unit { font-size: 28rpx; color: #666; margin: 0 8rpx; }
.stats-grid { display: flex; gap: 16rpx; }
.stat-item { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx; text-align: center; }
.stat-value { font-size: 32rpx; font-weight: 700; color: #1a1a2e; display: block; }
.stat-label { font-size: 20rpx; color: #8e8e93; }
