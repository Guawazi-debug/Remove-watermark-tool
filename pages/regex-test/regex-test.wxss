/* pages/regex-test/regex-test.wxss */
.input-section { margin: 24rpx 32rpx 0; }
.input-label { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.regex-row { display: flex; gap: 16rpx; }
.regex-input { flex: 1; height: 80rpx; background: #fff; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; border: 2rpx solid #e8f0fe; font-family: monospace; }
.flags-input { width: 120rpx; height: 80rpx; background: #fff; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; border: 2rpx solid #e8f0fe; text-align: center; font-family: monospace; }
.textarea-wrapper { background: #fff; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #e8f0fe; }
.input-textarea { width: 100%; height: 200rpx; font-size: 26rpx; color: #333; line-height: 1.5; overflow-y: auto; }
.result-section { margin: 32rpx 32rpx 0; }
.result-title { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 16rpx; display: block; }
.match-list { display: flex; flex-direction: column; gap: 12rpx; }
.match-item { background: #fff; border-radius: 12rpx; padding: 20rpx; display: flex; align-items: center; gap: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.match-index { font-size: 22rpx; color: #8e8e93; width: 48rpx; }
.match-value { flex: 1; font-size: 26rpx; color: #333; font-family: monospace; word-break: break-all; }
.match-pos { font-size: 22rpx; color: #8e8e93; }
.empty-state { display: flex; justify-content: center; padding: 60rpx 0; }
.empty-text { font-size: 28rpx; color: #8e8e93; }
