.history-page {
  background: #F8F3EC;
  padding-bottom: 120rpx;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 48rpx;
  font-weight: 700;
  color: #c4b5a8;
  margin-bottom: 24rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(194, 149, 106, 0.1);
  border-radius: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8c7e72;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #c4b5a8;
}

.history-list {
  padding: 24rpx;
}

.history-item {
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  border: 2rpx solid rgba(93, 66, 50, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(47, 33, 24, 0.06);
  overflow: hidden;
}

.history-item__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  cursor: pointer;
}

.history-item__prompt {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.history-item__index {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8f3d2e, #b45f3d);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-item__text {
  font-size: 28rpx;
  color: #241b16;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-item__arrow {
  font-size: 32rpx;
  color: #c4b5a8;
  margin-left: 16rpx;
  transition: transform 0.2s ease;
  transform: rotate(90deg);
  flex-shrink: 0;
}

.history-item__arrow--open {
  transform: rotate(270deg);
}

.history-item__body {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid rgba(93, 66, 50, 0.06);
}

.history-item__image-wrapper {
  margin-top: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f0eb;
}

.history-item__image {
  width: 100%;
  display: block;
}

.history-item__meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9a8f87;
}

.history-item__actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.history-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(143, 61, 46, 0.08);
  color: #8f3d2e;
  font-size: 24rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 64rpx;
  padding: 0;
}

.history-btn::after {
  border: none;
}
