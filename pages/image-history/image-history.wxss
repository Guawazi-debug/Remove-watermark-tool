.history-page {
  background: #F8F3EC;
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1rpx solid rgba(93, 66, 50, 0.06);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f5f0eb;
  border-radius: 32rpx;
}

.search-icon {
  font-size: 24rpx;
  color: #9a8f87;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #241b16;
}

.search-clear {
  font-size: 24rpx;
  color: #9a8f87;
  padding: 8rpx;
}

.filter-btn {
  height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(143, 61, 46, 0.08);
  color: #8f3d2e;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.filter-btn--active {
  background: #8f3d2e;
  color: #fff;
}

/* 筛选面板 */
.filter-panel {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1rpx solid rgba(93, 66, 50, 0.06);
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.filter-label {
  font-size: 26rpx;
  color: #241b16;
}

.filter-value {
  font-size: 26rpx;
  color: #9a8f87;
  padding: 12rpx 20rpx;
  background: #f5f0eb;
  border-radius: 8rpx;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.filter-btn-reset,
.filter-btn-apply {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
}

.filter-btn-reset::after,
.filter-btn-apply::after {
  border: none;
}

.filter-btn-reset {
  background: #f5f0eb;
  color: #5d4232;
}

.filter-btn-apply {
  background: #8f3d2e;
  color: #fff;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 48rpx;
  font-weight: 700;
  color: #c4b5a8;
  margin-bottom: 24rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(194, 149, 106, 0.1);
  border-radius: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8c7e72;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #c4b5a8;
}

.loading-box {
  display: flex;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #9a8f87;
}

.history-list {
  padding: 24rpx;
}

.history-item {
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  border: 2rpx solid rgba(93, 66, 50, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(47, 33, 24, 0.06);
  padding: 24rpx;
}

.history-item__header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.history-item__prompt {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.history-item__index {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8f3d2e, #b45f3d);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-item__text {
  font-size: 28rpx;
  color: #241b16;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-item__info {
  background: #f9f6f2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.history-item__row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.history-item__row:last-child {
  margin-bottom: 0;
}

.history-item__label {
  font-size: 24rpx;
  color: #9a8f87;
  flex-shrink: 0;
}

.history-item__value {
  font-size: 24rpx;
  color: #5d4232;
  word-break: break-all;
}

.history-item__actions {
  display: flex;
  gap: 16rpx;
}

.history-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
}

.history-btn::after {
  border: none;
}

.history-btn--copy {
  background: rgba(143, 61, 46, 0.08);
  color: #8f3d2e;
}

.history-btn--prompt {
  background: rgba(93, 66, 50, 0.08);
  color: #5d4232;
}

.history-total {
  text-align: center;
  font-size: 24rpx;
  color: #9a8f87;
  padding: 16rpx 0;
}

.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more__btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: rgba(143, 61, 46, 0.08);
  color: #8f3d2e;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.load-more__text {
  font-size: 24rpx;
  color: #c4b5a8;
}
