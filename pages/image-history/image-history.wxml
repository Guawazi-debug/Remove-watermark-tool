<navigation-bar title="生图历史" back="{{true}}" homeButton="{{true}}" color="#241b16" background="#F8F3EC"></navigation-bar>

<scroll-view class="page-root history-page" scroll-y enable-flex show-scrollbar="{{false}}">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">搜索</text>
      <input
        class="search-input"
        placeholder="搜索提示词..."
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">X</text>
    </view>
    <view class="filter-btn {{showFilter ? 'filter-btn--active' : ''}}" bindtap="onToggleFilter">
      <text>筛选</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-item">
      <text class="filter-label">开始日期</text>
      <picker mode="date" value="{{dateStart}}" bindchange="onDateStartChange">
        <text class="filter-value">{{dateStart || '请选择'}}</text>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">结束日期</text>
      <picker mode="date" value="{{dateEnd}}" bindchange="onDateEndChange">
        <text class="filter-value">{{dateEnd || '请选择'}}</text>
      </picker>
    </view>
    <view class="filter-actions">
      <button class="filter-btn-reset" bindtap="onResetFilter">重置</button>
      <button class="filter-btn-apply" bindtap="onApplyFilter">应用</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-box" wx:if="{{historyList.length === 0 && !loading}}">
    <text class="empty-icon">IMG</text>
    <text class="empty-text">暂无生图记录</text>
    <text class="empty-desc">使用 AI 生图后会在这里显示</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-box" wx:if="{{loading && historyList.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 历史列表 -->
  <view class="history-list" wx:else>
    <!-- 总数 -->
    <view class="history-total" wx:if="{{total > 0}}">
      <text>共 {{total}} 条记录</text>
    </view>

    <view
      class="history-item"
      wx:for="{{historyList}}"
      wx:key="id"
    >
      <!-- 序号和提示词 -->
      <view class="history-item__header">
        <view class="history-item__prompt">
          <text class="history-item__index">{{index + 1}}</text>
          <text class="history-item__text">{{item.prompt}}</text>
        </view>
      </view>

      <!-- 信息区 -->
      <view class="history-item__info">
        <view class="history-item__row">
          <text class="history-item__label">尺寸：</text>
          <text class="history-item__value">{{item.size}}</text>
        </view>
        <view class="history-item__row">
          <text class="history-item__label">时间：</text>
          <text class="history-item__value">{{item.created_at}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="history-item__actions">
        <button class="history-btn history-btn--copy" bindtap="onCopyUrl" data-url="{{item.image_url}}">复制链接</button>
        <button class="history-btn history-btn--prompt" bindtap="onCopyPrompt" data-prompt="{{item.prompt}}">复制提示词</button>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{historyList.length > 0}}">
      <view class="load-more__btn" wx:if="{{hasMore}}" bindtap="onLoadMore">
        <text wx:if="{{loadingMore}}">加载中...</text>
        <text wx:else>加载更多</text>
      </view>
      <view class="load-more__text" wx:else>
        <text>没有更多了</text>
      </view>
    </view>
  </view>
</scroll-view>
