.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.picker-btn text {
  font-size: 28rpx;
  color: #4a3f38;
}

.picker-icon {
  font-size: 24rpx;
  color: #8f3d2e;
}

.insurance-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.toggle-text {
  font-size: 26rpx;
  color: #666;
}

.insurance-info {
  background: linear-gradient(135deg, rgba(45, 99, 133, 0.12), rgba(45, 99, 133, 0.06));
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
}

.info-text {
  font-size: 22rpx;
  color: #2d6385;
  display: block;
  line-height: 1.6;
}

.result-main {
  background: linear-gradient(135deg, #8f3d2e, #c27a4a);
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.main-label {
  font-size: 24rpx;
  color: rgba(255, 247, 240, 0.78);
  display: block;
  margin-bottom: 8rpx;
}

.main-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff8f2;
}

.main-value.green {
  color: #fff1d7;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.result-item {
  width: calc(50% - 6rpx);
  background: rgba(255, 255, 255, 0.88);
  border-radius: 18rpx;
  padding: 16rpx;
  border: 2rpx solid rgba(93, 66, 50, 0.06);
}

.result-item.highlight {
  background: linear-gradient(135deg, rgba(194, 122, 74, 0.12), rgba(45, 99, 133, 0.08));
}

.result-label {
  font-size: 22rpx;
  color: #8a7c74;
  display: block;
  margin-bottom: 8rpx;
}

.result-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #241b16;
}

.result-value.red {
  color: #b84332;
}
