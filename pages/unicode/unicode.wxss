.section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.label { font-size: 26rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.mode-tabs { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.mode-tab { flex: 1; height: 72rpx; background: #f5f6fa; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #666; }
.mode-tab.active { background: linear-gradient(135deg, #4a90d9, #6c5ce7); color: #fff; }
.textarea-wrapper { background: #f5f6fa; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
.textarea { width: 100%; height: 160rpx; font-size: 26rpx; color: #333; line-height: 1.5; }
.result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.btn-group { display: flex; gap: 12rpx; }
.action-btn { padding: 8rpx 20rpx; background: #f0f0f0; border-radius: 8rpx; font-size: 24rpx; color: #666; }
.action-btn.primary { background: linear-gradient(135deg, #4a90d9, #6c5ce7); color: #fff; }
.result-content { background: #f5f6fa; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; color: #333; word-break: break-all; line-height: 1.6; }
