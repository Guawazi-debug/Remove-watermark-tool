/* pages/unit-convert/unit-convert.wxss */
.category-section { margin: 24rpx 32rpx 0; }
.category-tabs { display: flex; gap: 16rpx; }
.category-tab { flex: 1; height: 72rpx; background: #fff; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #666; border: 2rpx solid #e8f0fe; }
.category-tab--active { background: linear-gradient(135deg, #4a90d9, #6c5ce7); color: #fff; border-color: transparent; }
.convert-section { margin: 24rpx 32rpx 0; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.unit-group { margin-bottom: 16rpx; }
.unit-label { font-size: 24rpx; color: #8e8e93; margin-bottom: 8rpx; display: block; }
.unit-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.unit-tab { padding: 12rpx 24rpx; background: #f5f6fa; border-radius: 8rpx; font-size: 24rpx; color: #666; }
.unit-tab--active { background: #e8f0fe; color: #4a90d9; font-weight: 600; }
.value-input { height: 88rpx; background: #f5f6fa; border-radius: 12rpx; padding: 0 24rpx; font-size: 32rpx; font-family: monospace; text-align: center; margin: 16rpx 0; }
.swap-btn { text-align: center; font-size: 40rpx; color: #4a90d9; padding: 8rpx 0; }
.result-section { margin: 32rpx 32rpx 0; }
.result-label { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.result-content { background: #fff; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #e8f0fe; text-align: center; }
.result-value { font-size: 40rpx; color: #4a90d9; font-weight: 700; font-family: monospace; }
.btn--copy { margin-top: 16rpx; }
