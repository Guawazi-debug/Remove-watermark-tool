/* pages/date-calc/date-calc.wxss */
.section {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  display: block;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
}

.mode-tab {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
}

.mode-tab.active {
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  color: #fff;
}

.date-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.date-picker {
  flex: 1;
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-text {
  font-size: 28rpx;
  color: #333;
}

.date-icon {
  font-size: 32rpx;
}

.today-btn {
  height: 80rpx;
  padding: 0 24rpx;
  background: #e8f0fe;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #4a90d9;
}

.input {
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.result-section {
  background: linear-gradient(135deg, #f8f9fa, #e9ecef);
}

.result-box {
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.result-value {
  font-size: 32rpx;
  color: #00b894;
  font-weight: 600;
}
