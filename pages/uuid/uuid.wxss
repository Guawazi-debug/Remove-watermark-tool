/* pages/uuid/uuid.wxss */
.input-section { margin: 24rpx 32rpx 0; }
.input-label { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; display: block; }
.input-row { display: flex; gap: 16rpx; }
.count-input { flex: 1; height: 88rpx; background: #fff; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; border: 2rpx solid #e8f0fe; }
.result-section { margin: 32rpx 32rpx 0; }
.result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.result-title { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.result-actions { display: flex; gap: 12rpx; }
.action-btn { padding: 8rpx 24rpx; border-radius: 8rpx; background: #f0f0f0; font-size: 24rpx; color: #666; }
.action-btn--primary { background: linear-gradient(135deg, #4a90d9, #6c5ce7); color: #fff; }
.uuid-list { display: flex; flex-direction: column; gap: 12rpx; }
.uuid-item { background: #fff; border-radius: 12rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.uuid-text { font-size: 26rpx; color: #333; font-family: monospace; flex: 1; }
.uuid-copy { font-size: 24rpx; color: #4a90d9; margin-left: 16rpx; }
