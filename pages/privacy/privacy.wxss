.privacy-page {
  min-height: 100vh;
  background: #F8F3EC;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  width: 100%;
}

.privacy-content {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.privacy-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}
